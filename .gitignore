config.php

# Claude Code harness scratch space (isolated worktrees for background
# subagents) — local tooling state, never project content.
.claude/

# Log aplikace (vzniká za provozu, viz includes/log.php); .htaccess ve složce zůstává v repu.
logs/*
!logs/.htaccess

# Podklady testovacích map (tests/fixture/make-images.py) — nesmí do commitu ani na hosting.
uploads/mapy/testmapa_*
# Soubory, které vyrobí import oblasti (tests/e2e/oblast_api.js i ostrý provoz) — data, ne obsah repa
uploads/mapy/import_*
uploads/obrazky/import_*
